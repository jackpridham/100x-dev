{
  "manifest_version": 3,
  "name": "Vortex Git Control",
  "version": "1.4.3",
  "description": "Navigate GitHub issues chronologically and open common repository views with configurable key sequences.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/core.js", "src/github.js", "src/cache.js", "src/runtime.js", "src/pull-request.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/vortex-16.png",
    "32": "icons/vortex-32.png",
    "48": "icons/vortex-48.png",
    "128": "icons/vortex-128.png"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Vortex Git Control settings",
    "default_icon": {
      "16": "icons/vortex-16.png",
      "32": "icons/vortex-32.png"
    }
  }
}
